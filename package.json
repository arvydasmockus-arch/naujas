{
  "name": "pirmas-projektas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "start": "node server/dev.mjs --production",
    "backup:data": "node scripts/backup-data.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cloudflare:export": "node scripts/export-cloudflare-data.mjs",
    "cloudflare:dev": "wrangler dev --config wrangler.jsonc",
    "cloudflare:deploy": "wrangler deploy --config wrangler.jsonc",
    "cloudflare:migrate": "wrangler d1 migrations apply ml-academy --remote --config wrangler.jsonc",
    "test:solving": "node --test tests/*.test.mjs",
    "import:puzzles": "node scripts/import-yacpdb.mjs",
    "import:tournaments": "node scripts/import-tournament-puzzles.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "pdfkit": "^0.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
